
```env
APP_HOST=0.0.0.0
APP_PORT=8000

PG_HOST=postgres
PG_PORT=5432
PG_DB=arxiv
PG_USER=arxiv
PG_PASSWORD=arxiv

OS_HOST=opensearch
OS_PORT=9200
OS_USER=admin
OS_PASSWORD=admin
OS_INDEX=arxiv_papers
OS_USE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3:8b

# Embeddings & Reranking
EMBEDDING_PROVIDER=sbert
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HYBRID_ALPHA=0.6
